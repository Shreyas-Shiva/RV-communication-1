{
  "name": "communiq-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:branding": "node ../scripts/check_branding.mjs",
    "check:keys": "node ../scripts/check_keys.mjs",
    "setup:models": "node ../scripts/setup_models.mjs",
    "setup:site": "node ../scripts/setup_site.mjs",
    "audit": "python ../scripts/audit_codebase.py",
    "export:review": "node ../scripts/review_kit.mjs export",
    "import:review": "node ../scripts/review_kit.mjs import",
    "train:sign": "node ../scripts/train_sign.mjs",
    "prelaunch": "node ../scripts/prelaunch.mjs",
    "verify:live": "node ../scripts/verify_live.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.4.6",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.51.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
