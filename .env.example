# COMMUNIQ Environment Configuration Template
# Copy this file to .env and insert your free keys if using cloud AI providers.
# The app works 100% offline using LocalFallbackProvider when no keys are set.

# Groq Cloud API (Free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Available models: llama-3.3-70b-versatile, llama3-8b-8192, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (Free tier: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
# Available models: gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# Application Ports and Origins
PORT=8000
FRONTEND_URL=http://localhost:5173

# Optional MongoDB Atlas Storage Sync (Free M0 Sandbox cluster)
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=communiq
